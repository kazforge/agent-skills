{
  "reviewers": [
    {
      "workflow": "design-review",
      "title": "Design Review",
      "agentID": "kazforge-design-reviewer",
      "agent": {
        "name": "Design Reviewer",
        "description": "Challenges a proposed design for soundness, simplicity and repository fit. Inspects the repository read-only.",
        "mode": "subagent",
        "hidden": false,
        "permissions": [
          { "action": "*", "resource": "*", "effect": "deny" },
          { "action": "read", "resource": "*", "effect": "allow" },
          { "action": "grep", "resource": "*", "effect": "allow" },
          { "action": "glob", "resource": "*", "effect": "allow" },
          { "action": "skill", "resource": "*", "effect": "allow" },
          { "action": "read", "resource": "*.env", "effect": "deny" },
          { "action": "read", "resource": "*.env.*", "effect": "deny" },
          { "action": "read", "resource": "*.env.example", "effect": "allow" }
        ]
      }
    },
    {
      "workflow": "plan-review",
      "title": "Plan Review",
      "agentID": "kazforge-plan-reviewer",
      "agent": {
        "name": "Plan Reviewer",
        "description": "Checks whether an implementation plan is executable without material guessing. Inspects the repository read-only.",
        "mode": "subagent",
        "hidden": false,
        "permissions": [
          { "action": "*", "resource": "*", "effect": "deny" },
          { "action": "read", "resource": "*", "effect": "allow" },
          { "action": "grep", "resource": "*", "effect": "allow" },
          { "action": "glob", "resource": "*", "effect": "allow" },
          { "action": "skill", "resource": "*", "effect": "allow" },
          { "action": "read", "resource": "*.env", "effect": "deny" },
          { "action": "read", "resource": "*.env.*", "effect": "deny" },
          { "action": "read", "resource": "*.env.example", "effect": "allow" }
        ]
      }
    },
    {
      "workflow": "implementation-review",
      "title": "Implementation Review",
      "agentID": "kazforge-implementation-reviewer",
      "agent": {
        "name": "Implementation Reviewer",
        "description": "Independently checks a change-set against the requested outcome and repository contracts. Inspects the repository and asks before each verification command.",
        "mode": "subagent",
        "hidden": false,
        "permissions": [
          { "action": "*", "resource": "*", "effect": "deny" },
          { "action": "read", "resource": "*", "effect": "allow" },
          { "action": "grep", "resource": "*", "effect": "allow" },
          { "action": "glob", "resource": "*", "effect": "allow" },
          { "action": "skill", "resource": "*", "effect": "allow" },
          { "action": "read", "resource": "*.env", "effect": "deny" },
          { "action": "read", "resource": "*.env.*", "effect": "deny" },
          { "action": "read", "resource": "*.env.example", "effect": "allow" },
          { "action": "shell", "resource": "*", "effect": "ask" }
        ]
      }
    }
  ]
}
